@startuml Component_LightService
title SmartHome: Light Service Component Diagram

!includeurl ../c4/C4_Component.puml

System_Ext(LightSensor, "Light Sensor", "Модуль управления светом", "Протоколы: HTTP API, MQTT")

Container_Boundary(DeviceDomain, "Управление устройствами пользователей") {
  Container(DeviceService, "Device Service", "Go", "Централизованное управление:\n - Добавление/удаление устройств\n - Привязка к пользователю и локации\n - Отображение статуса")
}

Container_Boundary(TelemetryDomain, "Сбор и анализ телеметрии") {
  ContainerQueue(TelemetryQueue, "Telemetry Queue", "RabbitMQ", "Буферизация и доставка показателей телеметрии")
}

Container_Boundary(LightSensorDomain, "Управление освещением") {
  ContainerDb(LightDatabase, "Light Database", "PostgreSQL", "Хранение параметров осветительных модулей и состояния ламп")
    
  Container(LightService, "Light Service", "Go") {
    Component(HttpDeliveryLayer, "HTTP Service Layer", "Реализация HTTP-сервера для получения и обработки команд")
    Component(RepositoryLayer, "Repository Layer", "Слой работы с базой данных")
    Component(ServiceLayer, "Service Layer", "Логика обработки команд:\n - обработка команд управления модулями\n - обработка потока телеметрии")
    Component(SensorConnector, "Sensor Connector", "Коннектор подключения к модулям:\n - отправка команд\n - получение телеметрии")
    ComponentQueue(LightTelemetryQueue, "Light Telemetry Queue", "Очередь накопления и отправки телеметрии")

    Rel(HttpDeliveryLayer, ServiceLayer, "Передача на обработку запросов")
    Rel(ServiceLayer, RepositoryLayer, "Чтение/запись сущностей")
    Rel(ServiceLayer, SensorConnector, "Команды к подключённым модулям")
    Rel(ServiceLayer, LightTelemetryQueue, "Добавление в очередь телеметрии")
  }
}

Rel(DeviceService, HttpDeliveryLayer, "- Запросы на добавление/удаление модулей\n- Команды управления модулями", "HTTP")
Rel(RepositoryLayer, LightDatabase, "Чтение/Запись данных модулей", "SQL")
Rel(LightTelemetryQueue, TelemetryQueue, "Отправка данных телеметрии", "AMQP")

Rel(SensorConnector, LightSensor, "- Отправка команд модулю\n- Получение телеметрии")

@enduml