@startuml Component_DeviceTelemetryConnector
title WarmHouse: Device Telemetry Connector Component Diagram

!includeurl ../c4/C4_Component.puml

Boundary(Devices, "Devices") {
    System_Ext(WarmDevice, "Warm Device", "Датчик управления отоплением", "Uses HTTP API, MQTT")
    System_Ext(LightDevice, "Light Device", "Датчик управления светом", "Uses HTTP API, MQTT")
    System_Ext(DoorDevice, "Door Device", "Датчик управления воротами", "Uses HTTP API, MQTT")
    System_Ext(UniversalDevice, "Universal Device", "Универсальный датчик управления", "Uses HTTP API, MQTT")
}

Container_Boundary(TelemetryDomain, "Телеметрия устройств") {
    ContainerQueue(TelemetryQueueService, "Telemetry Queue", "RabbitMQ", "Доставка показателей телеметрии")
}

Container_Boundary(ScenarioProcessingDomain, "Выполнение сценариев") {
    ContainerQueue(ScenarioQueueService, "Scenario Queue", "RabbitMQ", "Асинхронное получение потока телеметрии для запуска триггеров по условию")    
}

Container_Boundary(DeviceIntegrationDomain, "Взаимодействие с устройствами") {
    ContainerDb(DeviceCache, "Device Cache", "Redis", "Кэширование параметров подключения к устройствам")
    ContainerQueue(TelemetryExchange, "Telemetry Exchange", "RabbitMQ", "Роутинг телеметрии устройств между очередями телеметрии")
}

Container(DeviceTelemetryConnector, "Device Telemetry Connector", "Go") {
  ComponentQueue(QueueDeliveryLayer, "Queue Delivery Layer", "Внутренняя очередь отправки телеметрии в брокер сообщений")
  Component(RepositoryLayer, "Repository Layer", "Чтение параметров подключения из базы данных")
  Component(ServiceLayer, "Service Layer", "Логика обработки команд")

  Component(WarmDeviceConnector, "WarmDeviceConnector", "Коннектор к устройствам управления отоплением")
  Component(LightDeviceConnector, "LightDeviceConnector", "Коннектор к устройствам управления светом")
  Component(DoorDeviceConnector, "DoorDeviceConnector", "Коннектор к устройствам управления воротами")
  Component(UniversalDeviceConnector, "UniversalDeviceConnector", "Коннектор к универсальным устройствам")
  

  Rel(ServiceLayer, QueueDeliveryLayer, "Передача команды из очереди на обработку")
  Rel(ServiceLayer, RepositoryLayer, "Получение параметров подключения")
  Rel(ServiceLayer, WarmDeviceConnector, "Отправка команды устройству")
  Rel(ServiceLayer, LightDeviceConnector, "Отправка команды устройству")
  Rel(ServiceLayer, DoorDeviceConnector, "Отправка команды устройству")
  Rel(ServiceLayer, UniversalDeviceConnector, "Отправка команды устройству")
}

Rel(QueueDeliveryLayer, TelemetryExchange, "Публикация телеметрии")
Rel(TelemetryExchange, TelemetryQueueService, "Роутинг сообщений в очередь")
Rel(TelemetryExchange, ScenarioQueueService, "Роутинг сообщений в очередь")
Rel(RepositoryLayer, DeviceCache, "Чтение параметров подключения к датчикам")

Rel(WarmDeviceConnector, WarmDevice, "Получение телеметрии от датчика")
Rel(LightDeviceConnector, LightDevice, "Получение телеметрии от датчика")
Rel(DoorDeviceConnector, DoorDevice, "Получение телеметрии от датчика")
Rel(UniversalDeviceConnector, UniversalDevice, "Получение телеметрии от датчика")

@enduml